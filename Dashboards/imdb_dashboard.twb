      <column caption='Decade' datatype='string' name='[Calculation_0742497451638784]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(INT(([Year]/10))*10)+&apos;s&apos;' />
      </column>
      <column caption='Runtime_bucket' datatype='string' name='[Calculation_0742497486639106]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Runtime (mins)] &lt; 90 THEN &quot;&lt;90&quot;&#13;&#10;ELSEIF [Runtime (mins)] &lt; 110 THEN &quot;90-110&quot;&#13;&#10;ELSEIF [Runtime (mins)] &lt; 130 THEN &quot;110-130&quot;&#13;&#10;ELSEIF [Runtime (mins)] &lt; 150 THEN &quot;130-150&quot;&#13;&#10;ELSEIF [Runtime (mins)] &lt; 170 THEN &quot;150-170&quot;&#13;&#10;ELSE &quot;170+&quot;&#13;&#10;END' />
      </column>
      <column caption='Year Span' datatype='string' name='[Calculation_0742498826276867]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(MIN([Year])) + &quot; – &quot; + STR(MAX([Year]))' />
      </column>
